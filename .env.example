# Copie para .env e ajuste. O docker compose lê este arquivo automaticamente.
# O .env está no .gitignore: nunca faça commit de senha ou token.

# Perfil: "demo" (dados de exemplo) ou vazio (loja real, banco começa vazio)
SPRING_PROFILES_ACTIVE=demo

DB_SENHA=margem

# Pelo menos 32 caracteres
MARGEM_JWT_SEGREDO=troque-por-um-segredo-longo-e-aleatorio

# Senhas criadas na primeira execução (fora do perfil demo)
MARGEM_SENHA_DONO=
MARGEM_SENHA_EXPEDICAO=

# Custos da loja
MARGEM_CUSTO_EMBALAGEM=1.50
MARGEM_ALIQUOTA_IMPOSTO=4.00

# Alertas no Telegram: crie um bot com o @BotFather e pegue o chat_id da conversa com ele
MARGEM_ALERTAS_HABILITADOS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shopee Open Platform (https://open.shopee.com). "simulada" funciona sem credenciais.
SHOPEE_MODO=simulada
SHOPEE_SINCRONIZACAO_HABILITADA=false
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
